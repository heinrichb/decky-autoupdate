{
  "name": "decky-autoupdate",
  "version": "0.1.0",
  "description": "Auto-updater for Steam Deck covering Steam games, Flatpak apps, Decky plugins, Decky Loader, and SteamOS.",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run && python3 -m unittest discover tests -v",
    "test:ts": "vitest run",
    "test:py": "python3 -m unittest discover tests -v",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/react": "^19.1.2",
    "prettier": "^3.8.1",
    "rollup": "^4.40.0",
    "rollup-plugin-import-assets": "^1.1.1",
    "shx": "^0.3.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.9.1",
    "react-icons": "^5.5.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
